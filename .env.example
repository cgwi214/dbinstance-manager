# 复制为 .env 即可生效（settings.py 启动时会自动加载，已加入 .gitignore）。
# 真实环境变量优先级高于 .env，容器里用 -e 注入不会被覆盖。

# ---- 接口鉴权 ----
# 1 = 开启（生产必须）；0 = 关闭（本地开发方便）
# 开启后：匿名 401；普通用户只能读；写操作/看明文凭据/轮换密码要求 staff
# 发 token：python manage.py create_api_token --username ops
# 只读账号：python manage.py create_api_token --username reader --no-staff
API_AUTH_REQUIRED=1

# ---- 基础 ----
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Shanghai

# ---- 数据库（不填则用 SQLite: var/db.sqlite3）----
# DB_ENGINE=postgres
# DB_NAME=dbinstance
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_CONN_MAX_AGE=60

# ---- 密码字段加密（生产必须配置）----
# 生成：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# 轮换：新密钥放最前面，旧密钥留在后面用于解密历史数据
INSTANCE_ENCRYPTION_KEYS=
INSTANCE_PASSWORD_LENGTH=24
INSTANCE_PASSWORD_ROTATION_HOURS=12

# ---- Celery ----
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# 本地无 Redis 时置 1：任务同步执行（同时让 POST /api/stats/daily/collect/ 走同步分支）
CELERY_TASK_ALWAYS_EAGER=0
CELERY_TIMEZONE=Asia/Shanghai

# ---- 请求耗时中间件 ----
REQUEST_TIMING_PERSIST=1
REQUEST_TIMING_SAMPLE_RATE=1.0
REQUEST_TIMING_SLOW_MS=500

# ---- 日志 ----
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
